{
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/app/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/app/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/app",
      "dest": "/index.html"
    },
    {
      "src": "/admin/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/admin.html",
      "dest": "/index.html"
    },
    {
      "src": "/admin",
      "dest": "/index.html"
    },
    {
      "src": "/demo/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/demo/(.*)",
      "status": 308,
      "headers": {
        "Location": "/app/$1"
      }
    },
    {
      "src": "/demo",
      "status": 308,
      "headers": {
        "Location": "/app"
      }
    },
    {
      "src": "/games-library.html",
      "dest": "/games-library.html"
    },
    {
      "src": "/games",
      "dest": "/games-library.html"
    },
    {
      "src": "/library",
      "dest": "/games-library.html"
    },
    {
      "src": "/croctot.html",
      "dest": "/croctot.html"
    },
    {
      "src": "/rileys-garden.html",
      "dest": "/rileys-garden.html"
    },
    {
      "src": "/(.*)",
      "dest": "/landing.html"
    }
  ]
}